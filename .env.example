# Where the "Try the live demo" buttons go. Defaults to the demo host.
NEXT_PUBLIC_DEMO_URL=https://demo.hostayo.casa/login?demo=1

# The real app (not the demo): where the footer Terms, Privacy, Cookie and Refund links point.
# Set this in Vercel too. Defaults to the app host.
NEXT_PUBLIC_APP_URL=https://app.hostayo.casa

# Required. Where people reach the team. Shown as the footer Contact link.
NEXT_PUBLIC_SUPPORT_EMAIL=support@hostayo.casa

# Google Analytics measurement ID for this site. Only loaded after a visitor chooses Accept all.
NEXT_PUBLIC_GA_ID=G-Y8L7VHPHQT
