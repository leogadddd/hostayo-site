# Where the "Try the live demo" links go. Defaults to the demo host.
NEXT_PUBLIC_DEMO_URL=https://demo.hostayo.casa/login?demo=1

# The real app (not the demo): where the footer Terms, Privacy, Cookie and Refund links point.
# Set this in Vercel too. Defaults to the app host.
NEXT_PUBLIC_APP_URL=https://app.hostayo.casa

# Required. Where people reach the team. Shown as the footer Contact link.
NEXT_PUBLIC_SUPPORT_EMAIL=support@hostayo.casa

# Google Analytics measurement ID for this site. Only loaded after a visitor chooses Accept all.
NEXT_PUBLIC_GA_ID=G-Y8L7VHPHQT

# Early-access form. Each request is emailed to the team. Server-only: never prefix
# these with NEXT_PUBLIC_. Set them in Vercel too.
# Recommended: Resend (https://resend.com, free tier). Create an API key, then verify
# hostayo.casa under Domains to send from your own address.
RESEND_API_KEY=
# Where requests are delivered. Any inbox you can reach.
EARLY_ACCESS_TO_EMAIL=
# Sender. Before the domain is verified, leave this unset (uses onboarding@resend.dev,
# which Resend only delivers to your own Resend account email).
# EARLY_ACCESS_FROM=Hostayo <hello@hostayo.casa>

# Copy kept in the Hostayo app (read by L1 operators at app.hostayo.casa/early-access), so a
# request survives a failed email. Same value as EARLY_ACCESS_API_SECRET in hostayo-app.
EARLY_ACCESS_API_SECRET=
# Optional. Defaults to NEXT_PUBLIC_APP_URL. Use http://localhost:3000 for local testing.
# EARLY_ACCESS_API_URL=

# Fallback if RESEND_API_KEY is not set: Gmail SMTP with a Google app password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
